# ===========================================================================
# AIvora Backend — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=local                          # local | staging | production
APP_NAME="AIvora Backend"
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG                    # DEBUG | INFO | WARNING | ERROR
APP_ALLOWED_HOSTS=["*"]

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aivora
DATABASE_USER=aivora
DATABASE_PASSWORD=aivora_secret
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Constructed automatically by settings — do not set manually
# DATABASE_URL=postgresql+asyncpg://aivora:aivora_secret@localhost:5432/aivora

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# ---------------------------------------------------------------------------
# Elasticsearch
# ---------------------------------------------------------------------------
ELASTICSEARCH_HOSTS=["http://localhost:9200"]
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=aivora_

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=4

# ---------------------------------------------------------------------------
# JWT / Security
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# ---------------------------------------------------------------------------
# File Storage
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local                  # local | s3 | gcs
STORAGE_LOCAL_UPLOAD_DIR=./uploads
# STORAGE_S3_BUCKET=my-aivora-bucket
# STORAGE_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# AI Providers (placeholders — filled when AI is implemented)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai                     # openai | anthropic | azure_openai
OPENAI_API_KEY=sk-CHANGEME
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aivora-backend
